# OpenGrok MCP Server — Environment Variables
# Copy: cp config/.env.example config/.env
#
# WARNING: config/.env is gitignored — never commit credentials!

# ---------------------------------------------------------------------------
# OpenGrok connection
# ---------------------------------------------------------------------------

# Base URL of the OpenGrok instance.
# Overrides opengrok.base_url in config.toml.
#OPENGROK_URL=https://opengrok.example.com

# HTTP request timeout in seconds (integer).
# Overrides opengrok.timeout_secs in config.toml.
#OPENGROK_TIMEOUT_SECS=30

# ---------------------------------------------------------------------------
# Authentication (used based on mode)
# ---------------------------------------------------------------------------

# Token mode: Bearer token (when mode = "token").
# Variable name configurable via opengrok.auth.token_env (default: OPENGROK_TOKEN).
#OPENGROK_TOKEN=e5163b59-c483-48fb-b9df-180627e7e91

# Basic mode: HTTP Basic Auth credentials (when mode = "basic").
# Variable names configurable via opengrok.auth.username_env / opengrok.auth.password_env.
#OPENGROK_USERNAME=myuser
#OPENGROK_PASSWORD=mypassword

# ---------------------------------------------------------------------------
# TLS / Custom CA certificates
# ---------------------------------------------------------------------------

# CA cert PEM file for corporate/self-signed TLS.
# Overrides opengrok.ca_cert in config.toml.
# Priority: OPENGROK_CA_CERT > SSL_CERT_FILE.
#OPENGROK_CA_CERT=./config/certs/ca.pem

# Alternative CA cert PEM path (standard OpenSSL variable).
# Ignored if OPENGROK_CA_CERT is set.
#SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# CA certificate directory (service-specific path).
# Overrides opengrok.ca_cert_dir in config.toml.
# Priority: OPENGROK_CA_CERT_DIR > SSL_CERT_DIR.
#OPENGROK_CA_CERT_DIR=./config/certs/

# CA certificate directory (standard OpenSSL variable).
# Ignored if OPENGROK_CA_CERT_DIR is set.
#SSL_CERT_DIR=/etc/ssl/certs

# Disable TLS verification (INSECURE — not for production!).
# Accepted values: false, 0, no (case-insensitive).
# Overrides opengrok.verify_ssl in config.toml.
#OPENGROK_VERIFY_SSL=false

# ---------------------------------------------------------------------------
# Service behaviour
# ---------------------------------------------------------------------------

# Strip HTML tags from search results.
# Overrides service.strip_html in config.toml.
# Accepted values: true/false, 1/0, yes/no (case-insensitive).
#MCP_STRIP_HTML=true

# Max matching lines per file.
# Overrides service.max_hits_per_file in config.toml.
#MCP_MAX_HITS_PER_FILE=10

# Default max result documents.
# Overrides service.default_max_results in config.toml.
#MCP_DEFAULT_MAX_RESULTS=25

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------

# Enable in-memory cache (Mutex<LruCache>, search results only).
# Accepted values: true/false, 1/0, yes/no (case-insensitive).
#MCP_CACHE_ENABLED=false

# Cache entry TTL in seconds (lazy eviction on access).
#MCP_CACHE_TTL_SECS=300

# Max cache entries (LRU eviction on overflow).
#MCP_CACHE_MAX_ENTRIES=1000

# ---------------------------------------------------------------------------
# Rate limit (token bucket, GCRA via governor)
# ---------------------------------------------------------------------------

# Enable rate limiting for outgoing OpenGrok API requests.
# Accepted values: true/false, 1/0, yes/no (case-insensitive).
#MCP_RATE_LIMIT_ENABLED=false

# Sustained request rate per second.
#MCP_RATE_LIMIT_RPS=5

# Maximum burst size.
#MCP_RATE_LIMIT_BURST=10

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

# Transport mode: "stdio", "http", or "both".
# Overrides transport.mode in config.toml.
#MCP_TRANSPORT=both

# HTTP bind address (only for mode = "http" or "both").
# Overrides transport.bind_addr in config.toml.
#MCP_BIND_ADDR=0.0.0.0:8080

# MCP endpoint path.
# Overrides transport.http_path in config.toml.
#MCP_HTTP_PATH=/mcp

# Health check (liveness) endpoint path.
# Overrides transport.health_path in config.toml.
#MCP_HEALTH_PATH=/healthz

# Readiness check endpoint path.
# Overrides transport.ready_path in config.toml.
#MCP_READY_PATH=/readyz

# Prometheus metrics endpoint path.
# Overrides transport.metrics_path in config.toml.
#MCP_METRICS_PATH=/metrics

# Allowed hostnames for DNS rebinding protection (comma-separated).
# Example: MCP_ALLOWED_HOSTS=localhost,opengrok-mcp:8004
# Overrides transport.allowed_hosts in config.toml.
#MCP_ALLOWED_HOSTS=

# Token for MCP HTTP transport protection (inbound auth).
# If set, every MCP request requires: Authorization: Bearer <token>.
# Has no effect on stdio transport.
# Can also be set directly in config.toml: mcp_auth_token = "..."
#MCP_AUTH_TOKEN=shared-secret-12345

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Log level (MCP-specific, applied before RUST_LOG).
# Accepted values: trace, debug, info, warn, error.
#MCP_LOG_LEVEL=info

# Log level (standard tracing variable, applied last).
#RUST_LOG=info

# ---------------------------------------------------------------------------
# Build metadata (CI/Docker only)
# ---------------------------------------------------------------------------

#GIT_HASH=a1b2c3d4
#BUILD_DATE=2026-07-25T14:30:00Z
