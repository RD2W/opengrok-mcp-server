# OpenGrok MCP Server — Environment Variables
# Copy this file to config/.env and fill in your values.

# OpenGrok instance URL (overrides opengrok.base_url in config.toml)
# OPENGROK_URL=https://opengrok.example.com

# Auth: basic mode
# OPENGROK_USERNAME=your-username
# OPENGROK_PASSWORD=your-http-password

# Auth: token mode
# OPENGROK_TOKEN=your-bearer-token

# TLS: custom CA certificate
# OPENGROK_CA_CERT=/path/to/ca.pem
# SSL_CERT_FILE=/path/to/ca.pem
# SSL_CERT_DIR=/etc/ssl/certs

# TLS: disable verification (not recommended for production)
# OPENGROK_VERIFY_SSL=false

# Logging level
# RUST_LOG=debug
